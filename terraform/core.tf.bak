# Networking resources for OctoTaskAI OKE

resource "oci_core_vcn" "okevcn" {
  cidr_block     = var.vcnCidr
  compartment_id = var.ociCompartmentOcid
  display_name   = "${var.projectName}-vcn"
  dns_label      = "octotask"
}

resource "oci_core_internet_gateway" "igw" {
  compartment_id = var.ociCompartmentOcid
  display_name   = "${var.projectName}-igw"
  vcn_id         = oci_core_vcn.okevcn.id
  enabled        = true
}

resource "oci_core_nat_gateway" "ngw" {
  compartment_id = var.ociCompartmentOcid
  vcn_id         = oci_core_vcn.okevcn.id
  display_name   = "${var.projectName}-nat-gateway"
  block_traffic  = false
}

resource "oci_core_service_gateway" "sgw" {
  compartment_id = var.ociCompartmentOcid
  vcn_id         = oci_core_vcn.okevcn.id
  display_name   = "${var.projectName}-service-gateway"

  services {
    service_id = data.oci_core_services.services.services[0].id
  }
}

data "oci_core_services" "services" {
  filter {
    name   = "name"
    values = ["All .* Services In Oracle Services Network"]
    regex  = true
  }
}

# Public route table for Kubernetes API endpoint and Load Balancer subnet
resource "oci_core_default_route_table" "public" {
  manage_default_resource_id = oci_core_vcn.okevcn.default_route_table_id
  display_name               = "${var.projectName}-public-rt"

  route_rules {
    description       = "Traffic to and from internet"
    destination       = "0.0.0.0/0"
    destination_type  = "CIDR_BLOCK"
    network_entity_id = oci_core_internet_gateway.igw.id
  }
}

# Private route table for worker nodes
resource "oci_core_route_table" "private" {
  compartment_id = var.ociCompartmentOcid
  vcn_id         = oci_core_vcn.okevcn.id
  display_name   = "${var.projectName}-private-rt"

  route_rules {
    description       = "Worker node outbound internet traffic through NAT"
    destination       = "0.0.0.0/0"
    destination_type  = "CIDR_BLOCK"
    network_entity_id = oci_core_nat_gateway.ngw.id
  }

  route_rules {
    description       = "Worker node access to OCI services"
    destination       = data.oci_core_services.services.services[0].cidr_block
    destination_type  = "SERVICE_CIDR_BLOCK"
    network_entity_id = oci_core_service_gateway.sgw.id
  }
}

# Kubernetes API endpoint subnet
resource "oci_core_subnet" "endpoint" {
  compartment_id             = var.ociCompartmentOcid
  vcn_id                     = oci_core_vcn.okevcn.id
  cidr_block                 = "10.0.0.0/28"
  display_name               = "${var.projectName}-endpoint-subnet"
  dns_label                  = "endpoint"
  security_list_ids          = [oci_core_security_list.endpoint.id]
  route_table_id             = oci_core_vcn.okevcn.default_route_table_id
  prohibit_public_ip_on_vnic = false
}

# Worker node private subnet
resource "oci_core_subnet" "nodePool_Subnet" {
  compartment_id             = var.ociCompartmentOcid
  vcn_id                     = oci_core_vcn.okevcn.id
  cidr_block                 = var.privateSubnetCidr
  display_name               = "${var.projectName}-nodepool-subnet"
  dns_label                  = "nodepool"
  security_list_ids          = [oci_core_security_list.nodePool.id]
  route_table_id             = oci_core_route_table.private.id
  prohibit_public_ip_on_vnic = true
}

# Public Load Balancer subnet
resource "oci_core_subnet" "svclb_Subnet" {
  compartment_id             = var.ociCompartmentOcid
  vcn_id                     = oci_core_vcn.okevcn.id
  cidr_block                 = "10.0.20.0/24"
  display_name               = "${var.projectName}-loadbalancer-subnet"
  dns_label                  = "svclb"
  security_list_ids          = [oci_core_security_list.svclb_sl.id]
  route_table_id             = oci_core_vcn.okevcn.default_route_table_id
  dhcp_options_id            = oci_core_vcn.okevcn.default_dhcp_options_id
  prohibit_public_ip_on_vnic = false
}

# Kubernetes API endpoint security list
resource "oci_core_security_list" "endpoint" {
  compartment_id = var.ociCompartmentOcid
  vcn_id         = oci_core_vcn.okevcn.id
  display_name   = "${var.projectName}-endpoint-sl"

  ingress_security_rules {
    source      = "0.0.0.0/0"
    protocol    = "6"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "External access to Kubernetes API endpoint"

    tcp_options {
      min = 6443
      max = 6443
    }
  }

  ingress_security_rules {
    source      = var.privateSubnetCidr
    protocol    = "6"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "Worker nodes to Kubernetes API endpoint"

    tcp_options {
      min = 6443
      max = 6443
    }
  }

  ingress_security_rules {
    source      = var.privateSubnetCidr
    protocol    = "6"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "Worker nodes to Kubernetes control plane"

    tcp_options {
      min = 12250
      max = 12250
    }
  }

  ingress_security_rules {
    source      = var.privateSubnetCidr
    protocol    = "1"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "Path discovery from worker nodes"

    icmp_options {
      type = 3
      code = 4
    }
  }

  egress_security_rules {
    destination      = var.privateSubnetCidr
    protocol         = "6"
    destination_type = "CIDR_BLOCK"
    stateless        = false
    description      = "Kubernetes API endpoint to worker nodes"
  }

  egress_security_rules {
    destination      = var.privateSubnetCidr
    protocol         = "1"
    destination_type = "CIDR_BLOCK"
    stateless        = false
    description      = "Path discovery to worker nodes"

    icmp_options {
      type = 3
      code = 4
    }
  }

  egress_security_rules {
    destination      = data.oci_core_services.services.services[0].cidr_block
    destination_type = "SERVICE_CIDR_BLOCK"
    protocol         = "6"
    stateless        = false
    description      = "Kubernetes API endpoint to OCI services"

    tcp_options {
      min = 443
      max = 443
    }
  }
}

# Worker node security list
resource "oci_core_security_list" "nodePool" {
  compartment_id = var.ociCompartmentOcid
  vcn_id         = oci_core_vcn.okevcn.id
  display_name   = "${var.projectName}-nodepool-sl"

  ingress_security_rules {
    source      = var.privateSubnetCidr
    protocol    = "all"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "Worker node to worker node communication"
  }

  ingress_security_rules {
    source      = "10.0.0.0/28"
    protocol    = "6"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "Control plane to worker nodes"
  }

  ingress_security_rules {
    source      = "10.0.0.0/28"
    protocol    = "1"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "Path discovery from Kubernetes control plane"

    icmp_options {
      type = 3
      code = 4
    }
  }

  egress_security_rules {
    destination      = var.privateSubnetCidr
    protocol         = "all"
    destination_type = "CIDR_BLOCK"
    stateless        = false
    description      = "Worker node to worker node communication"
  }

  egress_security_rules {
    destination      = "10.0.0.0/28"
    protocol         = "6"
    destination_type = "CIDR_BLOCK"
    stateless        = false
    description      = "Worker nodes to Kubernetes API endpoint"

    tcp_options {
      min = 6443
      max = 6443
    }
  }

  egress_security_rules {
    destination      = "10.0.0.0/28"
    protocol         = "6"
    destination_type = "CIDR_BLOCK"
    stateless        = false
    description      = "Worker nodes to Kubernetes control plane"

    tcp_options {
      min = 12250
      max = 12250
    }
  }

  egress_security_rules {
    destination      = data.oci_core_services.services.services[0].cidr_block
    destination_type = "SERVICE_CIDR_BLOCK"
    protocol         = "6"
    stateless        = false
    description      = "Worker nodes to OCI services"

    tcp_options {
      min = 443
      max = 443
    }
  }

  egress_security_rules {
    destination      = "0.0.0.0/0"
    protocol         = "all"
    destination_type = "CIDR_BLOCK"
    stateless        = false
    description      = "Worker nodes outbound internet access through NAT"
  }
}

# Public Load Balancer security list
resource "oci_core_security_list" "svclb_sl" {
  compartment_id = var.ociCompartmentOcid
  vcn_id         = oci_core_vcn.okevcn.id
  display_name   = "${var.projectName}-loadbalancer-sl"

  ingress_security_rules {
    source      = "0.0.0.0/0"
    protocol    = "6"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "HTTP traffic to public load balancer"

    tcp_options {
      min = 80
      max = 80
    }
  }

  ingress_security_rules {
    source      = "0.0.0.0/0"
    protocol    = "6"
    source_type = "CIDR_BLOCK"
    stateless   = false
    description = "HTTPS traffic to public load balancer"

    tcp_options {
      min = 443
      max = 443
    }
  }

  egress_security_rules {
    destination      = var.privateSubnetCidr
    protocol         = "6"
    destination_type = "CIDR_BLOCK"
    stateless        = false
    description      = "Load balancer to worker nodes"
  }
}