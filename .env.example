# Telegram
TELEGRAM_BOT_TOKEN=
# Optional shared secret; set the same value when registering the webhook
TELEGRAM_WEBHOOK_SECRET=

# Local LLM (Ollama) — companion process, offline, no API key
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Bot login — legacy shared access code (fallback "/login <code> <name>" path)
BOT_ACCESS_CODE=
# Issue one private per-user login code on startup (preferred "/login <code>" path)
BOT_LOGIN_CODES_SEED=false

# Oracle ATP (shared with OctoTask) — main schema: TASKS, APP_USER, SPRINT, TASK_STATE
DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
DB_USER=octotask
DB_PASSWORD=
DB_URL=jdbc:oracle:thin:@<service_name>?TNS_ADMIN=./wallet/ATP

# Oracle AI DB (bot-owned) — vector store (rutas_semanticas) + BOT_USER_LINK
db2_user=
db2_password=
db2_url=jdbc:oracle:thin:@<vector_service_name>?TNS_ADMIN=./wallet/AIDB
db2_driver_class_name=oracle.jdbc.OracleDriver

# Service
SERVER_PORT=8080
BOT_MEMORY_MAX_CHARS=200
